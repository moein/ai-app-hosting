# Copy to .env.dev / .env.prod (git-ignored). Non-secret values: specs/values.md.
# Worker secrets are uploaded with `pnpm secrets:<env>`; values are never printed.

# api
CF_API_TOKEN=             # Cloudflare token: Workers Scripts Edit + D1 Edit on the platform account
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=   # PKCS#8 PEM on one line, line breaks written as \n
LOGIN_CODE_PEPPER=        # generated by `pnpm secrets:<env>` when empty

# email
RESEND_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# dev only: e2e-inbox secret + E2E harness (spec 12)
E2E_INBOX_TOKEN=          # generated by `pnpm secrets:dev` when empty
E2E_API_ORIGIN=
E2E_APPS_DOMAIN=
E2E_INBOX_ORIGIN=
E2E_INBOX_ADDRESS=
E2E_PROBE_FROM=           # sender for the inbox self-test (F-E2E-1), on PLATFORM_MAIL_DOMAIN
E2E_INCLUDE_SLOW=0
