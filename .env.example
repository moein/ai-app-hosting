# Copy to .env (git-ignored). Values: specs/values.md. Secrets are uploaded with `pnpm secrets:<env>`.

# Worker secrets
RESEND_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
E2E_INBOX_TOKEN=          # generated by `pnpm secrets:dev` when empty
LOGIN_CODE_PEPPER_DEV=    # generated by `pnpm secrets:dev` when empty
LOGIN_CODE_PEPPER_PROD=   # generated by `pnpm secrets:prod` when empty

# E2E harness (spec 12)
E2E_API_ORIGIN=
E2E_APPS_DOMAIN=
E2E_INBOX_ORIGIN=
E2E_INBOX_ADDRESS=
E2E_PROBE_FROM=           # sender for the inbox self-test (F-E2E-1), on PLATFORM_MAIL_DOMAIN
E2E_INCLUDE_SLOW=0
