// Platform API + MCP server. Resources and placeholder values: specs/00-foundation/design.md, specs/values.md
// METRICS (Analytics Engine platform_metrics_<env>) is added once Analytics Engine is enabled on the account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "account_id": "ebdcbd8e905ff028ba30a0104288f65e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpSession"] }],
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "api-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        "CF_ACCOUNT_ID": "ebdcbd8e905ff028ba30a0104288f65e",
        "PLATFORM_API_ORIGIN": "https://api-dev.ai-app-hosting.workers.dev",
        "APPS_DOMAIN": "motad.app",
        "GITHUB_ORG": "AI-app-hosting"
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_SESSION", "class_name": "McpSession" },
          { "name": "APP_LOGS", "class_name": "AppLogBuffer", "script_name": "tail-dev" }
        ]
      },
      "services": [{ "binding": "MAIL", "service": "email-dev", "entrypoint": "PlatformMail" }],
      "queues": { "producers": [{ "binding": "EMAIL_JOBS", "queue": "email-jobs-dev" }] },
      "triggers": { "crons": ["0 3 * * *", "0 * * * *", "*/5 * * * *"] },
      "kv_namespaces": [{ "binding": "APP_ROUTES", "id": "4acad1cfc1ea43d9b25f6f2f10e5055f" }],
      "workflows": [
        { "binding": "PROVISION_APP", "name": "provision-app-dev", "class_name": "ProvisionApp" },
        { "binding": "DEPLOY_APP", "name": "deploy-app-dev", "class_name": "DeployApp" }
      ],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "artifacts-dev" }],
      "ratelimits": [{ "name": "TOOL_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "platform-db-dev",
          "database_id": "407bea98-c827-4fcb-a544-f4c0c4343949",
          "migrations_dir": "migrations"
        }
      ]
    },
    "prod": {
      "name": "api-prod",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "CF_ACCOUNT_ID": "ebdcbd8e905ff028ba30a0104288f65e",
        "PLATFORM_API_ORIGIN": "https://api-prod.ai-app-hosting.workers.dev",
        "APPS_DOMAIN": "", // prod domain not chosen yet (specs/values.md)
        "GITHUB_ORG": "AI-app-hosting"
      },
      "durable_objects": {
        "bindings": [
          { "name": "MCP_SESSION", "class_name": "McpSession" },
          { "name": "APP_LOGS", "class_name": "AppLogBuffer", "script_name": "tail-prod" }
        ]
      },
      "services": [{ "binding": "MAIL", "service": "email-prod", "entrypoint": "PlatformMail" }],
      "queues": { "producers": [{ "binding": "EMAIL_JOBS", "queue": "email-jobs-prod" }] },
      "triggers": { "crons": ["0 3 * * *", "0 * * * *", "*/5 * * * *"] },
      "kv_namespaces": [{ "binding": "APP_ROUTES", "id": "b0aca44ad9d3482792e13d4a559e3a7b" }],
      "workflows": [
        { "binding": "PROVISION_APP", "name": "provision-app-prod", "class_name": "ProvisionApp" },
        { "binding": "DEPLOY_APP", "name": "deploy-app-prod", "class_name": "DeployApp" }
      ],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "artifacts-prod" }],
      "ratelimits": [{ "name": "TOOL_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "platform-db-prod",
          "database_id": "983837a1-bc37-4678-8061-830a71637516",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
