{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types --env dev --strict-vars=false --env-interface Env",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@repo/app-contract": "workspace:*",
    "@repo/http": "workspace:*",
    "@repo/shared": "workspace:*",
    "agents": "0.24.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
