// PlatformMail (Resend) + AppMail (SES) entrypoints and the SES tenant job consumer (spec 11).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email",
  "account_id": "ebdcbd8e905ff028ba30a0104288f65e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "email-dev",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        "PLATFORM_MAIL_DOMAIN": "ideep.app",
        "APPS_DOMAIN": "motad.app",
        "AWS_REGION": "eu-central-1",
        "SES_CONFIGURATION_SET": "apps-dev"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "platform-db-dev", "database_id": "407bea98-c827-4fcb-a544-f4c0c4343949" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "platform_metrics_dev" }],
      "queues": {
        "consumers": [{ "queue": "email-jobs-dev", "max_batch_size": 10, "max_retries": 10 }]
      }
      // secrets: RESEND_API_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, CF_API_TOKEN (scripts/set-secrets.mjs)
    },
    "prod": {
      "name": "email-prod",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "PLATFORM_MAIL_DOMAIN": "ideep.app",
        "APPS_DOMAIN": "", // prod domain not chosen yet (specs/values.md)
        "AWS_REGION": "eu-central-1",
        "SES_CONFIGURATION_SET": "apps-prod"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "platform-db-prod", "database_id": "983837a1-bc37-4678-8061-830a71637516" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "platform_metrics_prod" }],
      "queues": {
        "consumers": [{ "queue": "email-jobs-prod", "max_batch_size": 10, "max_retries": 10 }]
      }
      // secrets: RESEND_API_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, CF_API_TOKEN (scripts/set-secrets.mjs)
    }
  }
}
