// Public homepage on the APPS_DOMAIN apex (spec 14). Values: specs/values.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "account_id": "ebdcbd8e905ff028ba30a0104288f65e",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "website-dev",
      // The Worker runs first for every request so it can add security headers and serve /api/config.
      "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "motad.app/*", "zone_name": "motad.app" }],
      "vars": {
        "MCP_URL": "https://api-dev.ai-app-hosting.workers.dev/mcp",
        "CONNECTOR_NAME": "AI App Hosting (dev)"
      }
    },
    "prod": {
      // Routes are added with the prod domain (specs/values.md).
      "name": "website-prod",
      // The Worker runs first for every request so it can add security headers and serve /api/config.
      "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "MCP_URL": "https://api-prod.ai-app-hosting.workers.dev/mcp", "CONNECTOR_NAME": "AI App Hosting" }
    }
  }
}
