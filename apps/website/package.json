{
  "name": "@repo/website",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "types": "wrangler types --env dev --strict-vars=false --env-interface Env",
    "deploy:dev": "CLOUDFLARE_ENV=dev vite build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=prod vite build && wrangler deploy"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
